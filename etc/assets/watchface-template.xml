    <!-- Dial -->

    <!-- Hands -->
    <AnalogClock
      height="450"
      width="450"
      x="200"
      y="0">

      <!-- Hour -->
      <HourHand
        height="450"
        resource="hour_shadow"
        width="50"
        x="0"
        y="0" />

      <HourHand
        height="450"
        resource="hour"
        width="50"
        x="0"
        y="0" />

      <!-- Minute -->
      <MinuteHand
        height="450"
        resource="minute_shadow"
        width="50"
        x="0"
        y="0" />

      <MinuteHand
        height="450"
        resource="minute"
        width="50"
        x="0"
        y="0" />

      <!-- Second -->
      <SecondHand
        height="450"
        resource="second_shadow"
        width="50"
        x="0"
        y="0">
        <Tick
          duration=".125"
          strength=".25" />

        <Variant
          mode="AMBIENT"
          target="alpha"
          value="0" />
      </SecondHand>

      <SecondHand
        height="450"
        resource="second"
        width="50"
        x="0"
        y="0">
        <Tick
          duration=".125"
          strength=".25" />

        <Variant
          mode="AMBIENT"
          target="alpha"
          value="0" />
