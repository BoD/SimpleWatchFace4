      slotId="0"
      supportedTypes="LONG_TEXT SHORT_TEXT EMPTY"
      width="300"
      x="75"
      y="70">
      <BoundingRoundBox
        cornerRadius="10"
        height="90"
        width="300"
        x="0"
        y="0" />
      <Complication type="LONG_TEXT">
        <PartText
          height="90"
          width="300"
