<WatchFace
  height="450"
  width="450">

  <Metadata
    key="CLOCK_TYPE"
    value="ANALOG" />

  <Scene>
    <!-- Left complication -->
    <ComplicationSlot
      displayName="left_complication_label"
      height="120"
      slotId="2"
      supportedTypes="GOAL_PROGRESS SHORT_TEXT EMPTY"
      width="120"
      x="68"
      y="165">
      <Variant
        mode="AMBIENT"
        target="alpha"
        value="0" />
      <BoundingOval
        height="120"
        width="120"
        x="0"
        y="0" />
      <Complication type="GOAL_PROGRESS">
        <PartDraw
          height="120"
          width="120"
          x="0"
          y="0">
          <Arc
            centerX="60"
            centerY="60"
            endAngle="355"
            height="116"
            startAngle="5"
            width="116">
            <Stroke
              cap="ROUND"
              color="#60FF8000"
              thickness="4" />
          </Arc>
          <Arc
            centerX="60"
            centerY="60"
            endAngle="355"
            height="116"
            startAngle="5"
            width="116">
            <Stroke
              cap="ROUND"
              color="#FF8000"
              thickness="4" />
            <Transform
              target="endAngle"
              value="5 + (clamp([COMPLICATION.GOAL_PROGRESS_VALUE], 0, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) / [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) * 350" />
          </Arc>
        </PartDraw>

        <PartText
          height="60"
          width="100"
          x="10"
          y="40">
          <Text isAutoSize="TRUE">
            <Font
              family="SYNC_TO_DEVICE"
              size="34">
              <Template><![CDATA[%s]]>
                <Parameter expression="[COMPLICATION.TEXT]" />
              </Template>
            </Font>
          </Text>
        </PartText>

        <PartImage
          height="42"
          width="42"
          x="39"
          y="8">
          <ImageFilters>
            <HsbFilter
              brightness="2"
              saturate="0" />
          </ImageFilters>
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
      </Complication>

      <Complication type="SHORT_TEXT">
        <PartText
          height="60"
          width="100"
          x="10"
          y="40">
          <Text isAutoSize="TRUE">
            <Font
              family="SYNC_TO_DEVICE"
              size="34">
              <Template><![CDATA[%s]]>
                <Parameter expression="[COMPLICATION.TEXT]" />
              </Template>
            </Font>
          </Text>
        </PartText>

        <PartImage
          height="42"
          width="42"
          x="39"
          y="8">
          <ImageFilters>
            <HsbFilter
              brightness="2"
              saturate="0" />
          </ImageFilters>
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!-- Right complication -->
    <ComplicationSlot
      displayName="right_complication_label"
